<odoo>
    <!-- Lista de entrenadores -->
    <record id="view_entrenador_list" model="ir.ui.view">
        <field name="name">ebro_football_academy.entrenador.list</field>
        <field name="model">ebro_football_academy.entrenador</field>
        <field name="arch" type="xml">
            <list string="Lista de entrenadores">
                <field name="nombreEntrenador" />
                <field name="apellidoEntrenador" />
                <field name="especialidadEntrenador" />
                <field name="telefonoEntrenador" />
                <field name="emailEntrenador" />
            </list>
        </field>
    </record>

    <!-- Buscador de entrenadores (filtros y agrupar) -->
    <record id="view_entrenador_search" model="ir.ui.view">
        <field name="name">ebro_football_academy.entrenador.search</field>
        <field name="model">ebro_football_academy.entrenador</field>
        <field name="arch" type="xml">
            <search>
                <field name="nombreEntrenador" />
                <field name="apellidoEntrenador" />
                <field name="especialidadEntrenador" />
                <filter name="filter_con_equipo" string="Con equipo"
                    domain="[('equipo_ids', '!=', False)]" />
                <filter name="filter_sin_equipo" string="Sin equipo"
                    domain="[('equipo_ids', '=', False)]" />
                <group>
                    <filter name="group_especialidad" string="Especialidad"
                        context="{'group_by': 'especialidadEntrenador'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Formulario del entrenador -->
    <record id="view_entrenador_form" model="ir.ui.view">
        <field name="name">ebro_football_academy.entrenador.form</field>
        <field name="model">ebro_football_academy.entrenador</field>
        <field name="arch" type="xml">
            <form string="Ficha del entrenador">
                <sheet>
                    <group>
                        <field name="fotoEntrenador" widget="image" />
                        <field name="nombreEntrenador" />
                        <field name="apellidoEntrenador" />
                        <field name="especialidadEntrenador" />
                        <field name="telefonoEntrenador" />
                        <field name="emailEntrenador" />
                    </group>
                    <notebook>
                        <page string="Equipos">
                            <field name="equipo_ids">
                                <list>
                                    <field name="nombreEquipo" />
                                    <field name="categoriaEquipo" />
                                </list>
                            </field>
                        </page>
                        <page string="Entrenamientos">
                            <field name="entrenamiento_ids">
                                <list>
                                    <field name="fechaEntrenamiento" />
                                    <field name="duracionEntrenamiento" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción: abre los entrenadores -->
    <record id="action_entrenador" model="ir.actions.act_window">
        <field name="name">ENTRENADORES</field>
        <field name="res_model">ebro_football_academy.entrenador</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_entrenador_list" />
        <field name="search_view_id" ref="view_entrenador_search" />
    </record>
</odoo>