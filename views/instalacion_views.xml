<odoo>

    <!-- Lista de instalaciones -->
    <record id="view_instalacion_list" model="ir.ui.view">
        <field name="name">ebro_football_academy.instalacion.list</field>
        <field name="model">ebro_football_academy.instalacion</field>
        <field name="arch" type="xml">
            <list>
                <field name="nombreInstalacion" />
                <field name="tipo" />
                <field name="ubicacion" />
                <field name="capacidad" />
                <field name="superficie" />
                <field name="disponible" />
            </list>
        </field>
    </record>

    <!-- Buscador de instalaciones (filtros y agrupar) -->
    <record id="view_instalacion_search" model="ir.ui.view">
        <field name="name">ebro_football_academy.instalacion.search</field>
        <field name="model">ebro_football_academy.instalacion</field>
        <field name="arch" type="xml">
            <search>
                <field name="nombreInstalacion" />
                <field name="ubicacion" />
                <filter name="filter_disponible" string="Disponibles"
                    domain="[('disponible', '=', True)]" />
                <filter name="filter_no_disponible" string="No disponibles"
                    domain="[('disponible', '=', False)]" />
                <group>
                    <filter name="group_tipo" string="Tipo"
                        context="{'group_by': 'tipo'}" />
                    <filter name="group_ubicacion" string="Ubicación"
                        context="{'group_by': 'ubicacion'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Formulario de la instalación -->
    <record id="view_instalacion_form" model="ir.ui.view">
        <field name="name">ebro_football_academy.instalacion.form</field>
        <field name="model">ebro_football_academy.instalacion</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="nombreInstalacion" />
                            <field name="tipo" />
                            <field name="ubicacion" />
                        </group>
                        <group>
                            <field name="capacidad" />
                            <field name="superficie" />
                            <field name="disponible" />
                        </group>
                    </group>
                    <group>
                        <field name="fotoInstalacion" widget="image" />
                        <field name="descripcion" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción: abre las instalaciones -->
    <record id="action_instalacion" model="ir.actions.act_window">
        <field name="name">Instalaciones</field>
        <field name="res_model">ebro_football_academy.instalacion</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_instalacion_search" />
    </record>

</odoo>