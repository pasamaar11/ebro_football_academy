<odoo>
    <!-- Lista de equipos -->
    <record id="view_equipo_list" model="ir.ui.view">
        <field name="name">ebro_football_academy.equipo.list</field>
        <field name="model">ebro_football_academy.equipo</field>
        <field name="arch" type="xml">
            <list>
                <field name="nombreEquipo" />
                <field name="categoriaEquipo" />
                <field name="temporada" />
                <field name="maxJugadores" />
                <field name="cantidad_jugadores" />
                <field name="plazas_libres" />
                <field name="activo" />
            </list>
        </field>
    </record>

    <!-- Buscador de equipos (filtros y agrupar) -->
    <record id="view_equipo_search" model="ir.ui.view">
        <field name="name">ebro_football_academy.equipo.search</field>
        <field name="model">ebro_football_academy.equipo</field>
        <field name="arch" type="xml">
            <search>
                <field name="nombreEquipo" />
                <field name="entrenador_id" />
                <filter name="filter_activo" string="Activos"
                    domain="[('activo', '=', True)]" />
                <filter name="filter_con_plazas" string="Con plazas libres"
                    domain="[('plazas_libres', '&gt;', 0)]" />
                <group>
                    <filter name="group_categoria" string="Categoría"
                        context="{'group_by': 'categoriaEquipo'}" />
                    <filter name="group_temporada" string="Temporada"
                        context="{'group_by': 'temporada'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Formulario del equipo -->
    <record id="view_equipo_form" model="ir.ui.view">
        <field name="name">ebro_football_academy.equipo.form</field>
        <field name="model">ebro_football_academy.equipo</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="nombreEquipo" />
                            <field name="categoriaEquipo" />
                            <field name="temporada" />
                            <field name="entrenador_id" />
                        </group>
                        <group>
                            <field name="maxJugadores" />
                            <field name="cantidad_jugadores" />
                            <field name="plazas_libres" />
                            <field name="activo" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Jugadores">
                            <field name="jugador_ids">
                                <list>
                                    <field name="nombreJugador" />
                                    <field name="apellidoJugador" />
                                    <field name="edad" />
                                </list>
                            </field>
                        </page>
                        <page string="Entrenamientos">
                            <field name="entrenamiento_ids">
                                <list>
                                    <field name="nombreEntrenamiento" />
                                    <field name="fechaEntrenamiento" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción: abre los equipos -->
    <record id="action_equipo" model="ir.actions.act_window">
        <field name="name">Equipos</field>
        <field name="res_model">ebro_football_academy.equipo</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_equipo_search" />
    </record>
</odoo>