<odoo>
    <!-- Lista de jugadores -->
    <record id="view_jugador_list" model="ir.ui.view">
        <field name="name">ebro_football_academy.jugador.list</field>
        <field name="model">ebro_football_academy.jugador</field>
        <field name="arch" type="xml">
            <list string="Lista de los jugadores">
                <field name="nombreJugador" />
                <field name="apellidoJugador" />
                <field name="edad" />
                <field name="posicionJugador" />
                <field name="categoriaJugador" />
                <field name="equipo_id" />
            </list>
        </field>
    </record>

    <!-- Buscador de jugadores (filtros y agrupar) -->
    <record id="view_jugador_search" model="ir.ui.view">
        <field name="name">ebro_football_academy.jugador.search</field>
        <field name="model">ebro_football_academy.jugador</field>
        <field name="arch" type="xml">
            <search>
                <field name="nombreJugador" />
                <field name="apellidoJugador" />
                <field name="equipo_id" />
                <filter name="filter_portero" string="Porteros"
                    domain="[('posicionJugador', '=', 'portero')]" />
                <filter name="filter_delantero" string="Delanteros"
                    domain="[('posicionJugador', '=', 'delantero')]" />
                <filter name="filter_sin_equipo" string="Sin equipo"
                    domain="[('equipo_id', '=', False)]" />
                <group>
                    <filter name="group_equipo" string="Equipo"
                        context="{'group_by': 'equipo_id'}" />
                    <filter name="group_posicion" string="Posición"
                        context="{'group_by': 'posicionJugador'}" />
                    <filter name="group_categoria" string="Categoría"
                        context="{'group_by': 'categoriaJugador'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Formulario del jugador -->
    <record id="view_jugador_form" model="ir.ui.view">
        <field name="name">ebro_football_academy.jugador.form</field>
        <field name="model">ebro_football_academy.jugador</field>
        <field name="arch" type="xml">
            <form string="Ficha del Jugador">
                <sheet>
                    <group>
                        <field name="fotoJugador" widget="image" />
                        <field name="nombreJugador" />
                        <field name="apellidoJugador" />
                        <field name="fecha_nacimiento" />
                        <field name="edad" />
                        <field name="posicionJugador" />
                        <field name="equipo_id" />
                        <field name="categoriaJugador" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción: abre los jugadores -->
    <record id="action_jugador" model="ir.actions.act_window">
        <field name="name">JUGADORES</field>
        <field name="res_model">ebro_football_academy.jugador</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_jugador_list" />
        <field name="search_view_id" ref="view_jugador_search" />
    </record>
</odoo>