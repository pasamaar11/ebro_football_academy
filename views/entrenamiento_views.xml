<odoo>
    <!-- Lista de entrenamientos (hecha por nosotros, no la automática) -->
    <record id="view_entrenamiento_list" model="ir.ui.view">
        <field name="name">ebro_football_academy.entrenamiento.list</field>
        <field name="model">ebro_football_academy.entrenamiento</field>
        <field name="arch" type="xml">
            <list string="Lista de entrenamientos">
                <field name="nombreEntrenamiento"/>
                <field name="fechaEntrenamiento"/>
                <field name="fechaHoraInicio"/>
                <field name="duracionEntrenamiento"/>
                <field name="entrenador_id"/>
                <field name="equipo_id"/>
                <field name="instalacion_id"/>
            </list>
        </field>
    </record>

    <!-- Formulario del entrenamiento -->
    <record id="view_entrenamiento_form" model="ir.ui.view">
        <field name="name">ebro_football_academy.entrenamiento.form</field>
        <field name="model">ebro_football_academy.entrenamiento</field>
        <field name="arch" type="xml">
            <form string="Ficha del entrenamiento">
                <sheet>
                    <group>
                        <field name="nombreEntrenamiento"/>
                        <field name="fechaEntrenamiento"/>
                        <field name="fechaHoraInicio"/>
                        <field name="duracionEntrenamiento"/>
                        <field name="entrenador_id"/>
                        <field name="equipo_id"/>
                        <field name="instalacion_id"/>
                        <field name="observaciones"/>
                    </group>
                    <notebook>
                        <page string="Jugadores">
                            <field name="jugador_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Buscador de entrenamientos (filtros y agrupar) -->
    <record id="view_entrenamiento_search" model="ir.ui.view">
        <field name="name">ebro_football_academy.entrenamiento.search</field>
        <field name="model">ebro_football_academy.entrenamiento</field>
        <field name="arch" type="xml">
            <search>
                <field name="nombreEntrenamiento"/>
                <field name="entrenador_id"/>
                <field name="equipo_id"/>
                <filter name="filter_largos" string="Más de 1,5 horas"
                    domain="[('duracionEntrenamiento', '&gt;', 1.5)]"/>
                <filter name="filter_sin_equipo" string="Sin equipo"
                    domain="[('equipo_id', '=', False)]"/>
                <group>
                    <filter name="group_entrenador" string="Entrenador"
                        context="{'group_by': 'entrenador_id'}"/>
                    <filter name="group_equipo" string="Equipo"
                        context="{'group_by': 'equipo_id'}"/>
                    <filter name="group_instalacion" string="Instalación"
                        context="{'group_by': 'instalacion_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Calendario: pone cada entrenamiento en su día y hora (duración en horas) -->
    <record id="view_entrenamiento_calendar" model="ir.ui.view">
        <field name="name">ebro_football_academy.entrenamiento.calendar</field>
        <field name="model">ebro_football_academy.entrenamiento</field>
        <field name="arch" type="xml">
            <calendar date_start="fechaHoraInicio" date_delay="duracionEntrenamiento"
                mode="month" color="entrenador_id">
                <field name="nombreEntrenamiento"/>
                <field name="entrenador_id"/>
                <field name="equipo_id"/>
            </calendar>
        </field>
    </record>

    <!-- Acción: abre los entrenamientos (lista, formulario y calendario) -->
    <record id="action_entrenamiento" model="ir.actions.act_window">
        <field name="name">Entrenamientos</field>
        <field name="res_model">ebro_football_academy.entrenamiento</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="view_id" ref="view_entrenamiento_list"/>
        <field name="search_view_id" ref="view_entrenamiento_search"/>
    </record>
</odoo>
